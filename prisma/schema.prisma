generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}
model User {
  id                  String   @id @default(uuid())
  fullName            String
  email               String   @unique
  passwordHash        String
  hashedRefreshToken  String?
  cv                  CV?
  swipes              Swipe[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model CV {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
  rawFileUrl       String
  parsedSkills     String[]
  parsedExperience Json
  parsedEducation  Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Job {
  id          String    @id @default(uuid())
  source      String
  externalId  String
  title       String
  company     String
  location    String
  description String
  salaryMin   Float?
  salaryMax   Float?
  redirectUrl String?
  skillTags   String[]  @default([])
  postedAt    DateTime?
  createdAt   DateTime  @default(now())
  swipes      Swipe[]

  @@unique([source, externalId])
}
model Swipe {
  id                 String              @id @default(uuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id])
  jobId              String
  job                Job                 @relation(fields: [jobId], references: [id])
  decision           String
  createdAt          DateTime            @default(now())
  generatedDocuments GeneratedDocument[]

  @@unique([userId, jobId])
}

model GeneratedDocument {
  id        String   @id @default(uuid())
  swipeId   String
  swipe     Swipe    @relation(fields: [swipeId], references: [id])
  type      String   // "cv" | "cover_letter"
  fileUrl   String
  createdAt DateTime @default(now())
}